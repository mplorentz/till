#!/usr/bin/env bash
# till — the repo's own definition of "CI passes".
# Same checks as .github/workflows/ci.yml; run before every PR.
set -euo pipefail
cd "$(dirname "$0")/.."

cargo fmt --all -- --check
cargo clippy --workspace --all-targets -- -D warnings
# US-14: card digits must never be committed or printed (ADR 0002).
./script/no-card-digits
cargo test --workspace
